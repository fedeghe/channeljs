{

    "testEnvironment": "node",
    "testMatch": [
        "<rootDir>/tests/*.test.js"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
        "dist/index.js"
    ],
    "coveragePathIgnorePatterns": [
        "node_modules",
        "tests",
        "source/tests/funczs.js"
    ],
    "coverageDirectory": "<rootDir>/coverage/",
    "coverageThreshold": {
        "global": {
            "branches": 20,
            "functions": 30,
            "lines": 50,
            "statements": 50
        }
    },
    "verbose": false
}
